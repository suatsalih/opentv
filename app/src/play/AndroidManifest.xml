<!--
  The Google Play edition only. Play restricts three permissions the sideloaded edition uses, and an
  app that declares them without qualifying is rejected, so they are removed here:

  - USE_EXACT_ALARM is reserved for alarm-clock and calendar apps. SCHEDULE_EXACT_ALARM stays: the
    user can grant it (Settings → Apps → Special app access → Alarms & reminders), and without it
    bookings fall back to an inexact alarm.
  - USE_FULL_SCREEN_INTENT is reserved for calling and alarm apps. Auto-switch reminders and
    recordings show a heads-up notification instead.
  - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is limited to a short list of use cases. The app opens the
    system battery-optimisation list instead, where the user can still exempt OpenTV.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

</manifest>
